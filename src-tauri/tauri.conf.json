{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Teropong",
  "version": "0.58.5",
  "identifier": "com.tedim20.teropong",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Teropong · Terminal Charting",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "theme": "Dark",
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Terminal charting desktop (fork dari trawangan)",
    "longDescription": "Teropong: terminal charting berbasis trawangan (github.com/KaleksananBarqi/trawangan), ditenagai LuxAlgo Vela dan PineTS",
    "publisher": "tedim20",
    "copyright": "Berbasis trawangan © 2026 Kaleksanan Barqi Aji Massani · Apache-2.0",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Indonesian"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEzMURFODgzNjdDN0IzMDQKUldRRXM4ZG5nK2dkbzJBc1AxNFlZS29LZVNSaDQwVmpTZXBKMXBkUFVZUDkyZ2ZMZUlFM09PcmMK",
      "endpoints": [
        "https://github.com/tedim20/teropong/releases/latest/download/latest.json"
      ]
    }
  }
}
